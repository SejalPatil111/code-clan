# =============================================================================
# CodeClan - Docker Compose environment (copy to ".env" in the project root)
#
#   copy .env.example .env
#
# The real .env is git-ignored. Never commit real passwords or secrets.
# This file is ONLY used by docker compose. The non-Docker workflow keeps using
# backend/.env (DATABASE_URL pointing at your Windows MySQL on localhost:3306).
# =============================================================================

# ---- Docker MySQL (separate from the Windows MySQL80 service) ---------------
# Created automatically the FIRST time the mysql_data volume is initialised.
# Changing these later does NOT change an already-initialised database.
MYSQL_DATABASE=codeclan
MYSQL_USER=codeclan_user
# Use letters, digits, "-" or "_" only (the password is embedded in DATABASE_URL).
MYSQL_PASSWORD=change-me-app-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# Host port for the Docker MySQL. 3307 avoids clashing with Windows MySQL on 3306.
MYSQL_HOST_PORT=3307

# Database host & port as seen by the backend container on the Docker network.
# Use the Compose service name ("mysql") and container port (3306), NOT localhost.
DB_HOST=mysql
DB_PORT=3306

# ---- Backend (FastAPI) ------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
TOKEN_TTL_SECONDS=86400
# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to true to log every SQL statement (noisy).
SQL_ECHO=false
DB_CONNECT_RETRIES=10
DB_CONNECT_DELAY_SECONDS=3

# ---- Frontend (Vite) --------------------------------------------------------
FRONTEND_PORT=5173
# Public value baked into browser code - NEVER put secrets in VITE_* variables.
# "/api" = go through the Vite proxy to the backend container (recommended).
VITE_API_BASE_URL=/api

# ---- Grader & Sandbox Execution Limits --------------------------------------
# EXECUTION_ENV: "development" (allows runc fallback on Windows) or "production" (requires gVisor runsc, fails closed).
EXECUTION_ENV=development
SANDBOX_RUNTIME=runsc
SANDBOX_REQUIRE_GVISOR=false
SANDBOX_ALLOW_DEV_FALLBACK=true
SANDBOX_IMAGE=codeclan-sandbox:latest
SANDBOX_RUN_TIMEOUT=3.0
SANDBOX_COMPILE_TIMEOUT=10.0
SANDBOX_MEMORY_MB=256
SANDBOX_CPUS=0.5
SANDBOX_PIDS_LIMIT=64
SANDBOX_NOFILE_LIMIT=64
SANDBOX_FSIZE_MB=16
GRADER_POLL_INTERVAL=1.0

# Timezone for the MySQL container
TZ=UTC
