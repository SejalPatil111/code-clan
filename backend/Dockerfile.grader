# CodeClan Grader Worker Dockerfile
# Runs the background submission queue processor and internal sample-execution RPC.
# Uses the static Docker CLI binary to spawn ephemeral, network-isolated
# `codeclan-sandbox:latest` sibling containers for untrusted student code.
FROM docker:27-cli AS docker-cli

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Run as non-root appuser (uid 10001); supplementary group 0 is added in
# docker-compose.yml (`group_add: ["0"]`) so the worker can talk to Docker Desktop's
# /var/run/docker.sock (owned by root:root 0660) without running as root UID 0.
RUN useradd --create-home --uid 10001 -G root appuser

COPY --chown=appuser:appuser . .

USER appuser

HEALTHCHECK --interval=15s --timeout=5s --start-period=25s --retries=5 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8090/health', timeout=4).status == 200 else 1)"

CMD ["python", "-m", "app.grading.worker"]
